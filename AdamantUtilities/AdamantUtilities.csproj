<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Adamant</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- AdamantCore is dependency-free, so this cannot introduce a cycle. Needed so the
         config loader and the rest of the app expand "~" through one shared implementation. -->
    <ProjectReference Include="..\AdamantCore\AdamantCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="8.0.1" />
  </ItemGroup>
</Project>
